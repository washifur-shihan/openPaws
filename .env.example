# Public Supabase values. These can be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only. Never expose this in frontend code or commit a real value to GitHub.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images

# Admin dashboard access. Add comma-separated emails if needed.
ADMIN_EMAILS=washifur.mail@gmail.com

# Google Sheets order sync.
GOOGLE_SHEETS_ID=11uLTsgZSkjCRS0KnKG5lIaNanB9-WTmEW7nAy5LKlk0
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_RANGE=Orders!A:Z

# Gemini-backed product assistant. Keep the API key server-only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional FastAPI chatbot fallback. Local example below. Replace with Render URL after deploy.
FASTAPI_CHAT_URL=http://localhost:8000/chat

# Optional store settings.
NEXT_PUBLIC_STORE_NAME=OpenPaws
NEXT_PUBLIC_WHATSAPP_NUMBER=8801700000000
NEXT_PUBLIC_DELIVERY_FEE=80
